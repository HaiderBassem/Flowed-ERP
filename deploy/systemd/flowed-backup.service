# One backup, verified in the same run that produced it.
[Unit]
Description=Flowed database backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=flowed
Group=flowed
EnvironmentFile=/etc/flowed/flowed.env
Environment=BACKUP_DIR=/srv/flowed/backups
ExecStart=/opt/flowed/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/flowed/backups
