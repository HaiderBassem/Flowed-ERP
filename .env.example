# Copy to .env and adjust. Nothing reads .env automatically — load it with
#   set -a && source .env && set +a
# before running, or let your process manager supply the variables.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=flowed-tuition
APP_ENV=development          # development | staging | production
APP_VERSION=dev
APP_TIMEZONE=Asia/Baghdad    # presentation only; every timestamp is stored UTC

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=30s    # in-flight financial transactions must finish
HTTP_MAX_BODY_BYTES=33554432
HTTP_TRUSTED_PROXIES=        # comma-separated CIDRs; empty means read the socket
HTTP_CORS_ORIGINS=*          # must be an explicit list in production
# Rate limiting. The budget is per client address and is enforced across every
# replica, so this is the real figure and not one to divide by the replica
# count. Per address means per campus NAT: a hall of thirty cashier terminals
# shares one bucket, which is what 600 is sized for.
#
# HTTP_RATE_LIMIT_SHARED=false falls back to a per-process bucket. One round
# trip cheaper, and correct only on a single replica.
HTTP_RATE_LIMIT_PER_MINUTE=600
HTTP_RATE_LIMIT_SHARED=true
HTTP_RATE_LIMIT_IDLE_TTL=10m # how long an untouched bucket survives the sweeper

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flowed
DB_SSLMODE=disable           # must not be disable in production

# Pool. Size against PostgreSQL's max_connections and the replica count, not
# against expected concurrency: this workload serialises on row locks long
# before it saturates a large pool.
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=10s

# Guardrails applied to every session. statement_timeout bounds a runaway
# report; lock_timeout stops a second cashier waiting forever on a locked
# account; the idle-in-transaction timeout reclaims locks held by a client that
# disappeared mid-transaction. Lock timeout must stay below statement timeout so
# a lock wait fails with the precise error.
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=10s
DB_IDLE_IN_TX_TIMEOUT=60s

# Never enable in production: statements carry student identifiers and amounts.
DB_LOG_QUERIES=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# At least 32 bytes in production. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=development-secret-change-me-in-production
AUTH_ACCESS_TOKEN_TTL=12h    # long enough for a cashier shift, short enough that a stolen token expires
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_ISSUER=flowed-tuition
AUTH_BCRYPT_COST=12

# ---------------------------------------------------------------------------
# Printed receipts
# ---------------------------------------------------------------------------
# What the letterhead says. Configuration rather than constants so one binary
# serves any university.
RECEIPT_UNIVERSITY_NAME=الجامعة
RECEIPT_COLLEGE_NAME=
RECEIPT_ADDRESS=
RECEIPT_PHONE=
# An inline logo (data: URI). Inlined rather than linked because a receipt must
# print identically from a desk with no network.
RECEIPT_LOGO_DATA_URI=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info               # debug | info | warn | error
LOG_FORMAT=json              # json | text
LOG_INCLUDE_SOURCE=false

# ---------------------------------------------------------------------------
# Metrics and tracing
# ---------------------------------------------------------------------------
# Metrics are pulled and default to on; traces are pushed and default to off.
# That matches what the two cost to run: a scrape endpoint needs nothing
# standing between this process and the dashboard, while a trace exporter with
# no collector in front of it produces retry noise and nothing else.
#
# The scrape endpoint has its own listener, bound to loopback. It enumerates
# every route and its error rate — a map of the system — and it carries no
# authentication, because the bind address is the access control. A deployment
# scraped from another host sets 0.0.0.0 deliberately and firewalls the port.
OBS_METRICS_ENABLED=true
OBS_METRICS_ADDR=127.0.0.1:9464
OBS_METRICS_PATH=/metrics

# OTLP over HTTP rather than gRPC: it goes through an ordinary reverse proxy,
# which is what a university network has between the application host and
# anything else. The path is completed automatically, so the collector's base
# URL is enough.
#
# Cannot be combined with DB_LOG_QUERIES: pgx takes one tracer per connection,
# and the configuration refuses the pair rather than letting one silently win.
OBS_TRACING_ENABLED=false
OBS_OTLP_ENDPOINT=http://localhost:4318
OBS_TRACE_SAMPLE_RATIO=0.05  # applied at the root and inherited, so no trace is half-recorded
OBS_SHUTDOWN_TIMEOUT=5s      # bounds the final flush, after the API has drained

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Rolling back a migration in production drops data, so the down command
# refuses unless this is set explicitly.
# MIGRATE_CONFIRM_PRODUCTION=yes

# ---------------------------------------------------------------------------
# Audit archive
# ---------------------------------------------------------------------------
# The hash chain in audit_log detects an altered entry. It cannot detect a
# deleted one: verification walks what is present, so a removed tail leaves an
# intact chain behind it. The control that covers that is a copy on a host this
# database cannot reach.
#
# A directory works when it is a mount of one on another machine, owned by
# another account, where this process may create files and may not rewrite
# them. A directory on the same disk is worse than nothing, because it looks
# like a control.
# AUDIT_ARCHIVE_DIR=/srv/audit-archive
#
# Or an append-only endpoint. The secret signs the body; without it, anyone who
# finds the URL can append.
# AUDIT_ARCHIVE_URL=https://archive.university.edu.iq/flowed
# AUDIT_ARCHIVE_SECRET=
AUDIT_ARCHIVE_BATCH=500
# The interval is the exposure: an entry written just after a pass exists only
# where it can be deleted until the next one.
AUDIT_ARCHIVE_INTERVAL=15m
AUDIT_ARCHIVE_TIMEOUT=30s
